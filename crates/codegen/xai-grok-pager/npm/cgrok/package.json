{
    "name": "@gucooing/cgrok",
    "version": "1.0.45",
    "description": "Bring Grok into your terminal",
    "license": "Apache-2.0",
    "bin": {
        "cgrok": "bin/cgrok"
    },
    "files": [
        "bin/"
    ],
