        "@gucooing/cgrok-darwin-x64": "1.0.45",
        "@gucooing/cgrok-linux-arm64": "1.0.45",
        "@gucooing/cgrok-linux-x64": "1.0.45",
        "@gucooing/cgrok-win32-arm64": "1.0.45",
        "@gucooing/cgrok-win32-x64": "1.0.45"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gucooing/grok-build.git"
